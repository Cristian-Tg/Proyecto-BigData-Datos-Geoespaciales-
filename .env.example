# ===========================================================================
# Plantilla de configuracion.  Copiar a .env y ajustar:   cp .env.example .env
# ---------------------------------------------------------------------------
# .env ESTA EN .gitignore.  Ningun secreto real debe llegar al repositorio.
# En Jenkins estos valores se inyectan con el plugin Credentials.
# ===========================================================================

# --- MongoDB ---------------------------------------------------------------
MONGO_ROOT_USER=geoadmin
MONGO_ROOT_PASSWORD=cambiame_en_local
MONGO_DB=geobigdata
MONGO_COLLECTION=accidents
MONGO_PORT=27017
# URI que usan los contenedores dentro de la red de compose
MONGO_URI=mongodb://geoadmin:cambiame_en_local@mongo:27017/geobigdata?authSource=admin

# --- Kaggle ----------------------------------------------------------------
# NO poner aqui el token real si el archivo se llegara a versionar.
# En local: dejar vacio y colocar kaggle.json en ./secrets/kaggle.json
# En Jenkins: credencial de tipo "Secret file" con id 'kaggle-json'
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=sobhanmoosavi/us-accidents
KAGGLE_FILE=US_Accidents_March23.csv

# --- Ingesta ---------------------------------------------------------------
# Numero maximo de registros a cargar. El enunciado exige >= 1.000.000
SAMPLE_SIZE=2000000
# Tamano de lote para insert_many hacia MongoDB
BATCH_SIZE=20000
# Tamano de particion que lee Dask desde el CSV
DASK_BLOCKSIZE=64MB
# Si es 1 se genera un dataset sintetico cuando no hay credenciales de Kaggle
ALLOW_SYNTHETIC_FALLBACK=1

# --- Dask ------------------------------------------------------------------
DASK_SCHEDULER=tcp://dask-scheduler:8786
DASK_N_WORKERS=2
DASK_THREADS_PER_WORKER=2
DASK_WORKER_MEMORY=2g

# --- Spark -----------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g

# --- API Flask -------------------------------------------------------------
API_PORT=5000
API_HOST=0.0.0.0
FLASK_ENV=production
API_MAX_LIMIT=1000
API_DEFAULT_LIMIT=100

# --- Puertos publicados en el host ----------------------------------------
DASK_DASHBOARD_PORT=8787
SPARK_MASTER_UI_PORT=8080
JENKINS_PORT=8088
MONGO_EXPRESS_PORT=8081

# --- Analisis geoespacial --------------------------------------------------
GRID_CELL_DEG=0.1
GEOHASH_PRECISION=5

# Mapa: clave de CARTO Basemaps (opcional; sin ella se usa OpenStreetMap)
CARTO_API_KEY=
